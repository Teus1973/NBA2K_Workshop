# Copy to .env and fill in as needed. All values are optional; defaults are safe.

# ---------------------------------------------------------------------------
# Scraping etiquette
# ---------------------------------------------------------------------------
# Request rate for 2kratings.com in requests per second. Keep <= 1.0 for
# personal use. Lower is politer.
NBA2K_WORKSHOP_SCRAPE_RPS=1.0

# Custom User-Agent for outbound HTTP. Identify yourself; please do not spoof.
NBA2K_WORKSHOP_USER_AGENT=NBA2K-Workshop/0.1 (+personal-use)

# HTTP cache TTL (seconds). After this age, cached HTML/JSON is refetched.
NBA2K_WORKSHOP_CACHE_TTL=86400

# ---------------------------------------------------------------------------
# Streamlit
# ---------------------------------------------------------------------------
NBA2K_WORKSHOP_PORT=8506

# ---------------------------------------------------------------------------
# Google Sheets export (optional — reuse SubtitleForge credentials)
# ---------------------------------------------------------------------------
# Path to a Google OAuth client credentials.json (Desktop app type).
# If unset, the Google Sheets export button is disabled.
GOOGLE_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------
# Optional local LLM for scouting-report phrase extraction (off by default)
# ---------------------------------------------------------------------------
NBA2K_WORKSHOP_USE_OLLAMA=0
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
